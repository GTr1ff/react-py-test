{
	// Cloudflare Python Worker. On WSL/Linux/macOS run with
	// `uv run pywrangler dev` and deploy with `uv run pywrangler deploy`.
	"name": "python-worker-wsl",
	"main": "worker.py",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"python_workers",
		"python_dedicated_snapshot",
		"disable_python_external_sdk"
	],
	"assets": {
		"directory": "../web-static/dist/client",
		"not_found_handling": "single-page-application",
		// Only these paths reach the Python worker. Everything else is served
		// from the assets directory, falling back to the SPA.
		"run_worker_first": [
			"/api/*",
			"/docs",
			"/docs/*",
			"/openapi.json"
		]
	},
	// The database is the SQLite storage of the PreviewBackend Durable Object
	"durable_objects": {
		"bindings": [
			{
				"name": "BACKEND",
				"class_name": "PreviewBackend"
			}
		]
	},
	// Declarative Durable Object lifecycle (replaces the legacy `migrations` array).
	// Note: once deployed with `exports`, the Worker cannot go back to `migrations`.
	"exports": {
		"PreviewBackend": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"vars": {
		"ENV": "development"
	}
}
