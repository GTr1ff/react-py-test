{
	// Cloudflare Python Worker (open beta) — pywrangler flow (WSL/Linux/macOS):
	// run with `uv run pywrangler dev`, deploy with `uv run pywrangler deploy`.
	"name": "python-worker-wsl",
	"main": "worker.py",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"python_workers",
		"python_dedicated_snapshot",
		// Serve the runtime's built-in `workers`/`asgi` SDK. The installed
		// workers-py (1.16.x) predates the external-SDK vendoring the runtime
		// asks for at this compatibility date; once workers-py ships it, try
		// removing this flag.
		"disable_python_external_sdk"
	],
	"assets": {
		// Built React SPA from ../web-static — run `bun run build` (or npm) there
		// before `pywrangler dev`/`deploy`; wrangler errors if the directory is missing.
		"directory": "../web-static/dist/client",
		// Unmatched paths (client-side routes) get index.html with a 200.
		"not_found_handling": "single-page-application",
		// /api/* plus FastAPI's docs UI reach the Python worker; every other
		// path is served from the assets directory (SPA fallback included).
		"run_worker_first": [
			"/api/*",
			"/docs",
			"/docs/*",
			"/openapi.json"
		]
	},
	// The database is the SQLite storage of the PreviewBackend Durable Object
	// exported by worker.py; the FastAPI app runs inside that object. Nothing to
	// create beforehand — locally the data lives under .wrangler/state.
	"durable_objects": {
		"bindings": [
			{
				"name": "BACKEND",
				"class_name": "PreviewBackend"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PreviewBackend"]
		}
	],
	"vars": {
		"ENV": "development"
	}
}
