# Generated for react-py
# Backend API URL — relative: the API is same-origin (Vite proxy in dev,
# the Python worker serving these assets in prod).
VITE_API_BASE_URL=/api

# Application title
VITE_APP_TITLE=react-py Rosetic App

# API naming convention: snake_case | camelCase
VITE_API_NAMING_CONVENTION=snake_case

# Enable debug logging
VITE_DEBUG_MODE=false

# Enable mocks mode. Off: repositories hit the real Python API. Note only
# the datatypestest feature exists server-side — other tables will 404.
VITE_USE_MOCKS=false