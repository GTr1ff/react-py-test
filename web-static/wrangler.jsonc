{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tastebot2",
	"main": "worker/index.ts",
	"compatibility_date": "2026-03-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"!/api/docs/*"
		]
	}
}